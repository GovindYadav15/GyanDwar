datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Identity, Users & Roles
// -------------------------------------------------------------

enum RoleType {
  SUPER_ADMIN
  ADMIN
  CONTENT_EDITOR
  INSTRUCTOR
  STUDENT
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userRoles    UserRole[]
  subscriptions Subscription[]
  orders       Order[]
  attempts     AssessmentAttempt[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleType   @unique
  description String?
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

// -------------------------------------------------------------
// 2. Educational Hierarchy
// -------------------------------------------------------------

enum CategoryCode {
  NEC
  LOK_SEWA
  DIPLOMA
}

model ExamCategory {
  id           String             @id @default(uuid())
  code         CategoryCode       @unique
  title        String
  description  String
  iconUrl      String?
  displayOrder Int                @default(0)
  isPublished  Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  faculties    Faculty[]
  entitlements PlanEntitlement[]

  @@map("exam_categories")
}

model Faculty {
  id           String       @id @default(uuid())
  categoryId   String
  category     ExamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  code         String
  description  String?
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  examTracks   ExamTrack[]

  @@unique([categoryId, code])
  @@map("faculties")
}

model ExamTrack {
  id           String    @id @default(uuid())
  facultyId    String
  faculty      Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  name         String
  code         String
  description  String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subjects     Subject[]

  @@unique([facultyId, code])
  @@map("exam_tracks")
}

model Subject {
  id           String      @id @default(uuid())
  examTrackId  String
  examTrack    ExamTrack   @relation(fields: [examTrackId], references: [id], onDelete: Cascade)
  name         String
  code         String
  description  String?
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  chapters     Chapter[]
  assessments  Assessment[]

  @@unique([examTrackId, code])
  @@map("subjects")
}

model Chapter {
  id            String             @id @default(uuid())
  subjectId     String
  subject       Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title         String
  chapterNumber Int
  description   String?
  isFreePreview Boolean            @default(false)
  displayOrder  Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  resources     LearningResource[]
  questions     Question[]

  @@unique([subjectId, chapterNumber])
  @@map("chapters")
}

enum ResourceType {
  NOTES
  PDF
  SYLLABUS
  EXTERNAL_LINK
}

model LearningResource {
  id            String       @id @default(uuid())
  chapterId     String
  chapter       Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title         String
  resourceType  ResourceType @default(NOTES)
  content       String?      // Rich-text / Markdown notes
  fileUrl       String?      // S3 storage URL
  fileSizeBytes Int?
  isFreePreview Boolean      @default(false)
  displayOrder  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("learning_resources")
}

// -------------------------------------------------------------
// 3. Question Bank & Assessment Engine
// -------------------------------------------------------------

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Question {
  id              String               @id @default(uuid())
  chapterId       String
  chapter         Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questionText    String
  richMediaUrl    String?
  difficulty      DifficultyLevel      @default(MEDIUM)
  marks           Decimal              @default(1.0) @db.Decimal(5, 2)
  negativeMarks   Decimal              @default(0.2) @db.Decimal(5, 2)
  status          QuestionStatus       @default(PUBLISHED)
  explanationText String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  options         AnswerOption[]
  assessmentQuestions AssessmentQuestion[]
  attemptResponses AttemptResponse[]

  @@map("questions")
}

model AnswerOption {
  id          String   @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionLabel String   // 'A', 'B', 'C', 'D'
  optionText  String
  isCorrect   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("answer_options")
}

enum AssessmentType {
  CHAPTER_PRACTICE
  SUBJECT_MOCK
  FULL_MOCK
}

model Assessment {
  id              String               @id @default(uuid())
  subjectId       String?
  subject         Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  type            AssessmentType       @default(CHAPTER_PRACTICE)
  totalMarks      Decimal              @default(100.0) @db.Decimal(6, 2)
  passMarks       Decimal              @default(50.0) @db.Decimal(6, 2)
  durationMinutes Int                  @default(120)
  isFree          Boolean              @default(false)
  isPublished     Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@map("assessments")
}

model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  questionId   String
  displayOrder Int        @default(0)
  marks        Decimal    @default(1.0) @db.Decimal(5, 2)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

model AssessmentAttempt {
  id             String            @id @default(uuid())
  userId         String
  assessmentId   String
  status         AttemptStatus     @default(IN_PROGRESS)
  startedAt      DateTime          @default(now())
  expiresAt      DateTime
  submittedAt    DateTime?
  scoreObtained  Decimal?          @db.Decimal(6, 2)
  totalMarks     Decimal           @db.Decimal(6, 2)
  accuracyRate   Decimal?          @db.Decimal(5, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment     Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responses      AttemptResponse[]

  @@map("assessment_attempts")
}

model AttemptResponse {
  id                    String            @id @default(uuid())
  attemptId             String
  questionId            String
  selectedOptionId      String?
  isCorrect             Boolean?
  marksAwarded          Decimal           @default(0.0) @db.Decimal(5, 2)
  negativeMarksDeducted Decimal           @default(0.0) @db.Decimal(5, 2)
  timeSpentSeconds      Int               @default(0)
  isMarkedForReview     Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  attempt               AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question              Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("attempt_responses")
}

// -------------------------------------------------------------
// 4. Subscriptions, Orders & Payment Gateways
// -------------------------------------------------------------

model SubscriptionPlan {
  id           String            @id @default(uuid())
  name         String
  code         String            @unique
  description  String?
  durationDays Int               // 30, 90, 365
  priceNpr     Decimal           @db.Decimal(10, 2)
  discountNpr  Decimal           @default(0.0) @db.Decimal(10, 2)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]
  orders        Order[]

  @@map("subscription_plans")
}

model PlanEntitlement {
  id                String           @id @default(uuid())
  planId            String
  categoryId        String
  canAccessNotes    Boolean          @default(true)
  canAccessPractice Boolean          @default(true)
  canAccessFullMock Boolean          @default(true)
  createdAt         DateTime         @default(now())

  plan              SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  category          ExamCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([planId, categoryId])
  @@map("plan_entitlements")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String
  planId      String
  amountNpr   Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@map("orders")
}

enum PaymentGateway {
  ESEWA
  KHALTI
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id                   String         @id @default(uuid())
  orderId              String
  gateway              PaymentGateway
  gatewayTransactionId String?        @unique
  amountNpr            Decimal        @db.Decimal(10, 2)
  status               PaymentStatus  @default(INITIATED)
  rawResponse          String?        // JSON string of verification payload
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events               PaymentEvent[]

  @@map("payments")
}

model PaymentEvent {
  id        String   @id @default(uuid())
  paymentId String
  eventType String
  payload   String   // JSON audit
  createdAt DateTime @default(now())

  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_events")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  payload      String?  // JSON details
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
