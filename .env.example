# -------------------------------------------------------------
# ExamSathi Nepal (GyanDwar) - Environment Configuration Template
# NOTE: Never commit production values or real secrets to git.
# -------------------------------------------------------------

# Application Environment
NODE_ENV=development
APP_NAME=ExamSathi Nepal
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Backend Port
PORT=4000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/examsathi_dev?schema=public

# Redis Configuration (Optional for dev caching & queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Token Lifecycle
JWT_SECRET=super_secret_development_jwt_key_min_32_characters_long_12345
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_min_32_characters_long_67890
JWT_REFRESH_EXPIRES_IN=30d

# eSewa Payment Gateway (EPAY v2 Sandbox)
# Reference: https://developer.esewa.com.np
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_SUCCESS_URL=http://localhost:3000/payments/verify/esewa
ESEWA_FAILURE_URL=http://localhost:3000/payments/failure

# Khalti Payment Gateway (ePayment v2 Sandbox)
# Reference: https://docs.khalti.com
KHALTI_PUBLIC_KEY=test_public_key_dc74e0fd57cb46cd93832aee0a505e0
KHALTI_SECRET_KEY=test_secret_key_f59e8b7d18b24b9993ea11a81a34a2e
KHALTI_BASE_URL=https://a.khalti.com/api/v2
KHALTI_RETURN_URL=http://localhost:3000/payments/verify/khalti

# Object Storage (S3-compatible / MinIO / Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=examsathi-resources
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
