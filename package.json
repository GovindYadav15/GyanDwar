{
  "name": "examsathi-nepal-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready examination preparation platform for Nepal (NEC, Lok Sewa, Diploma License)",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm --filter @examsathi/api dev & pnpm --filter @examsathi/web dev",
    "dev:api": "pnpm --filter @examsathi/api dev",
    "dev:web": "pnpm --filter @examsathi/web dev",
    "build": "pnpm --filter @examsathi/shared build && pnpm --filter @examsathi/api build && pnpm --filter @examsathi/web build",
    "test": "pnpm --filter @examsathi/api test:unit",
    "test:unit": "pnpm --filter @examsathi/api test:unit",
    "test:integration": "pnpm --filter @examsathi/api test:unit",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @examsathi/api db:generate",
    "db:migrate": "pnpm --filter @examsathi/api db:migrate",
    "db:seed": "pnpm --filter @examsathi/api db:seed",
    "db:studio": "pnpm --filter @examsathi/api db:studio",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "prisma": "^6.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
